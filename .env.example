# Copy to .env.local and fill in from Supabase → Project Settings → API (Data API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon" key – both are safe to expose in the browser
VITE_SUPABASE_KEY=sb_publishable_xxx

# Only for `npm run q:import` (direct database import). Put the real value in .env.local, never commit it.
# Supabase → Connect → Session pooler → URI, with your database password filled in.
SUPABASE_DB_URL=
